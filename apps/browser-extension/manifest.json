{
  "manifest_version": 3,
  "name": "ODM — Open Download Manager",
  "version": "0.4.0",
  "description": "Send download links to Open Download Manager (opt-in native messaging).",
  "permissions": ["contextMenus", "nativeMessaging", "storage", "scripting"],
  "optional_permissions": ["downloads", "cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": ["youtube-button.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ODM",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "odm@opendownloadmanager.app",
      "strict_min_version": "109.0"
    }
  }
}
