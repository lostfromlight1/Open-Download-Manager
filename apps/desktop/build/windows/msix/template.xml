<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="odm.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Open Download Manager contributors\Open Download Manager">
    </Installer>
    <PackageInformation
        PackageName="Open Download Manager"
        PackageDisplayName="Open Download Manager"
        PublisherName="CN=Open Download Manager contributors"
        PublisherDisplayName="Open Download Manager contributors"
        Version="0.5.0.0"
        PackageDescription="Open-source download manager desktop shell">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.opendownloadmanager.desktop"
                Description="Open-source download manager desktop shell"
                DisplayName="Open Download Manager"
                ExecutableName="odm.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Open Download Manager</DisplayName>
            <PublisherDisplayName>Open Download Manager contributors</PublisherDisplayName>
            <Description>Open-source download manager desktop shell</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="odm.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
